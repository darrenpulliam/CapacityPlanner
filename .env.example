# Copy to .env. Anything left unset falls back to C:\CrystalBull\CB_v4.0\.env(.prod), read-only.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
CAPACITY_MAIL_TO=dppharmd@gmail.com
# Garmin credentials are used by --setup ONLY and belong in the Windows user
# environment (setx GARMIN_EMAIL / GARMIN_PASSWORD, single-quote the password).
# Leave these blank. Scheduled runs are token-only and never log in.
GARMIN_EMAIL=
GARMIN_PASSWORD=
