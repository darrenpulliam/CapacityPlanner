# Copy to .env. This folder's .env is the ONLY source (no CrystalBull fallback since 2026-10-18).
# TELEGRAM_BOT_TOKEN = the planner's own bot, @dp_health_consultant_bot (BotFather). Never CrystalBull's.
# TELEGRAM_CHAT_ID   = the owner chat (from getUpdates after sending /start to the bot).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
GMAIL_USERNAME=
GMAIL_APP_PASSWORD=
CAPACITY_MAIL_TO=dppharmd@gmail.com
# Garmin credentials are used by --setup ONLY and belong in the Windows user
# environment (setx GARMIN_EMAIL / GARMIN_PASSWORD, single-quote the password).
# Leave these blank. Scheduled runs are token-only and never log in.
GARMIN_EMAIL=
GARMIN_PASSWORD=
